<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FocusGuard" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#FF7C3AED</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorPrimaryContainer">#FFE8EEF6</item>
        <item name="colorSecondary">#FF0891B2</item>
        <item name="colorOnSecondary">#FFFFFFFF</item>
        <item name="colorSurface">#FFF4F7FB</item>
        <item name="colorOnSurface">#FF0F172A</item>
        <item name="android:windowBackground">#FFF4F7FB</item>
        <item name="android:statusBarColor">#FFF4F7FB</item>
        <item name="android:navigationBarColor">#FFF4F7FB</item>
    </style>

    <style name="Theme.FocusGuard.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFF4F7FB</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
