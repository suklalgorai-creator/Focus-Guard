<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F00C0C14"
    android:clickable="true"
    android:focusable="true">

    <!-- Main content container — friction layers swap views here -->
    <LinearLayout
        android:id="@+id/friction_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Primary message (motivating line) -->
        <TextView
            android:id="@+id/text_primary_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="You chose distraction again."
            android:textColor="#F0F0F5"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="12dp" />

        <!-- Secondary message / question text -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="12dp"
            android:fadingEdge="vertical"
            android:fillViewport="true">

            <TextView
                android:id="@+id/text_secondary_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text=""
                android:textColor="#C0F0F0F5"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:fontFamily="sans-serif" />
        </ScrollView>

        <!-- Progress bar (for delays / loading) -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="12dp"
            android:max="1000"
            android:progress="0"
            android:progressTint="#FF4D6D"
            android:progressBackgroundTint="#212130"
            android:visibility="gone" />

        <!-- Countdown timer text -->
        <TextView
            android:id="@+id/text_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text=""
            android:textColor="#FF4D6D"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Task container (memory grid, etc.) -->
        <FrameLayout
            android:id="@+id/task_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Options container for MCQs -->
        <LinearLayout
            android:id="@+id/options_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="12dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="8dp">
                <Button
                    android:id="@+id/btn_option_a"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="A"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#212130"
                    android:textSize="16sp"
                    android:textAllCaps="false"/>
                <Button
                    android:id="@+id/btn_option_b"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="B"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#212130"
                    android:textSize="16sp"
                    android:textAllCaps="false"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
                <Button
                    android:id="@+id/btn_option_c"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="C"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#212130"
                    android:textSize="16sp"
                    android:textAllCaps="false"/>
                <Button
                    android:id="@+id/btn_option_d"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="D"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#212130"
                    android:textSize="16sp"
                    android:textAllCaps="false"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Input field -->
        <EditText
            android:id="@+id/input_answer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/edit_text_bg"
            android:hint="Type A, B, C, or D"
            android:textColorHint="#5C5C6E"
            android:textColor="#F0F0F5"
            android:textSize="16sp"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:padding="14dp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Submit button -->
        <Button
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="8dp"
            android:text="Submit Answer"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:backgroundTint="#FF4D6D"
            android:visibility="gone" />

        <!-- Attempt counter -->
        <TextView
            android:id="@+id/text_attempt_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text=""
            android:textColor="#5C5C6E"
            android:textSize="12sp"
            android:gravity="center" />

    </LinearLayout>

</FrameLayout>
